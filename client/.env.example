# Client environment variables (Vite). Copy to .env.local and fill in.
# .env.local is gitignored and takes priority.

# Base URL of the backend API (no trailing slash).
VITE_API_URL=http://localhost:5000

# WebSocket / Socket.IO server URL (usually same as the API).
VITE_WS_URL=http://localhost:5000

# Google OAuth client ID. Optional — if empty, the "Sign in with Google"
# buttons are hidden and email/password auth still works.
VITE_GOOGLE_CLIENT_ID=

# Cloudinary unsigned upload config for image uploads. Optional — if empty,
# images are embedded as data URLs (fine for local testing).
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
