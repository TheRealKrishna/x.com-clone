# Server environment variables. Copy to .env.local and fill in.
# .env.local is gitignored and takes priority over .env.
#
# Everything here is OPTIONAL for local development:
#   - With no MONGO_URI, the server starts an in-memory MongoDB automatically
#     (data is ephemeral and lost on restart).
#   - With no JWT_SECRET, a dev-only secret is used (NOT safe for production).

# Port the API listens on (default 5000).
PORT=5000

# MongoDB connection string. Leave empty to use the in-memory dev database.
# Examples:
#   mongodb://localhost:27017/xclone           (local mongod / Docker)
#   mongodb+srv://user:pass@cluster/xclone      (MongoDB Atlas)
MONGO_URI=

# Secret used to sign JWTs. REQUIRED in production. Generate a strong value:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Comma-separated list of allowed browser origins for CORS (no trailing slash).
# In development, any localhost origin is allowed automatically.
FRONTEND_URL=http://localhost:5173

# Set to "production" to enforce MONGO_URI + JWT_SECRET and disable dev fallbacks.
NODE_ENV=development
